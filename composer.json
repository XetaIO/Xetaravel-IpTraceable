{
    "name": "xetaio/xetaravel-iptraceable",
    "description": "A simple package that update an IP field when the user login into the application.",
    "keywords": [
        "laravel",
        "ip",
        "traceable",
        "users",
        "login"
    ],
    "homepage": "https://github.com/XetaIO/Xetaravel-IpTraceable",
    "support": {
        "source": "https://github.com/XetaIO/Xetaravel-IpTraceable",
        "issues": "https://github.com/XetaIO/Xetaravel-IpTraceable/issues"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Xety",
            "email": "zoro.fmt@gmail.com",
            "homepage": "https://github.com/Xety"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "psr-4": {
            "Xetaio\\IpTraceable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}